<UserControl x:Class="WorkingHours.Views.TodoSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFont}" FontSize="13"
             PreviewKeyDown="Root_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="TodoCheck" TargetType="{x:Type CheckBox}">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Width="20" Height="20" Background="Transparent">
                            <Ellipse x:Name="Circle" Width="18" Height="18"
                                     Stroke="{DynamicResource ForegroundDarkerBrush}" StrokeThickness="1.4" />
                            <Path x:Name="Check" Data="M 4 9 L 7.5 12.5 L 14 5"
                                  Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TodoListItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddTaskButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BackgroundLightBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="16,0,10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="M 1 1 L 4 1 L 4 4 L 1 4 Z M 1 6 L 4 6 L 4 9 L 1 9 Z M 1 11 L 4 11 L 4 14 L 1 14 Z M 6 2.5 L 15 2.5 M 6 7.5 L 15 7.5 M 6 12.5 L 15 12.5"
                      Stroke="{DynamicResource ForegroundDarkerBrush}" StrokeThickness="1.3"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource L.Tasks}" FontSize="14" FontWeight="SemiBold"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Padding="6" Click="Close_Click"
                    ToolTip="{DynamicResource L.Close}"
                    AutomationProperties.Name="{DynamicResource L.Close}">
                <Path Data="M 2 2 L 10 10 M 10 2 L 2 10"
                      Stroke="{DynamicResource ForegroundDarkerBrush}" StrokeThickness="1.3"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Button>
        </Grid>

        <!-- New task -->
        <Grid Grid.Row="1" Margin="14,8,14,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid>
                <TextBox x:Name="NewTaskBox" MaxLength="240"
                         Text="{Binding NewTodoText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="NewTaskBox_KeyDown" />
                <TextBlock Text="{DynamicResource L.NewTaskPlaceholder}"
                           Margin="11,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource ForegroundDarkestBrush}"
                           IsHitTestVisible="False" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=NewTaskBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button Grid.Column="1" Style="{StaticResource AddTaskButton}" Margin="8,0,0,0"
                    Command="{Binding AddCommand}" ToolTip="{DynamicResource L.AddTask}"
                    AutomationProperties.Name="{DynamicResource L.AddTask}">
                <Path Data="M 8 2 L 8 14 M 2 8 L 14 8"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Button>
        </Grid>

        <!-- Task list -->
        <Grid Grid.Row="2" Margin="8,4,4,4">
            <ListBox x:Name="TasksList" ItemsSource="{Binding Items}"
                     ItemContainerStyle="{StaticResource TodoListItem}"
                     Background="Transparent" BorderThickness="0"
                     Padding="4,0,4,6"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     PreviewMouseLeftButtonDown="TasksList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="TasksList_PreviewMouseMove"
                     PreviewMouseLeftButtonUp="TasksList_PreviewMouseLeftButtonUp">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="5" CornerRadius="8" Margin="0,2">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="8" Height="14" Margin="1,4,8,0"
                                          VerticalAlignment="Top" Background="Transparent"
                                          Cursor="SizeAll"
                                          ToolTip="{DynamicResource L.DragToReorder}"
                                          AutomationProperties.Name="{DynamicResource L.DragToReorder}">
                                        <UniformGrid Columns="2" Rows="3" Width="8" Height="14">
                                            <Ellipse Width="2" Height="2" Fill="{DynamicResource ForegroundDarkestBrush}" />
                                            <Ellipse Width="2" Height="2" Fill="{DynamicResource ForegroundDarkestBrush}" />
                                            <Ellipse Width="2" Height="2" Fill="{DynamicResource ForegroundDarkestBrush}" />
                                            <Ellipse Width="2" Height="2" Fill="{DynamicResource ForegroundDarkestBrush}" />
                                            <Ellipse Width="2" Height="2" Fill="{DynamicResource ForegroundDarkestBrush}" />
                                            <Ellipse Width="2" Height="2" Fill="{DynamicResource ForegroundDarkestBrush}" />
                                        </UniformGrid>
                                    </Grid>

                                    <CheckBox Grid.Column="1" Style="{StaticResource TodoCheck}"
                                              IsChecked="{Binding IsDone, Mode=TwoWay}"
                                              VerticalAlignment="Top" Margin="0,2,8,0" />

                                    <StackPanel Grid.Column="2" Margin="0,1,6,0">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            <Setter Property="Foreground" Value="{DynamicResource ForegroundDarkerBrush}" />
                                                            <Setter Property="Opacity" Value="0.6" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                                    Visibility="{Binding HasTime, Converter={StaticResource BoolToVisibility}}">
                                            <Grid Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center">
                                                <Ellipse Stroke="{DynamicResource ForegroundDarkerBrush}"
                                                         StrokeThickness="1" Margin="0.5" />
                                                <Path Data="M 5 2.5 L 5 5.2 L 7 6.2"
                                                      Stroke="{DynamicResource ForegroundDarkerBrush}"
                                                      StrokeThickness="1" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" />
                                            </Grid>
                                            <TextBlock Text="{Binding TimeText}" FontSize="10" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundDarkerBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTracking}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Style="{StaticResource IconButton}" Padding="4"
                                                Command="{Binding DataContext.ToggleTrackingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding TrackingTooltip}"
                                                AutomationProperties.Name="{Binding TrackingTooltip}"
                                                Visibility="{Binding IsDone, Converter={StaticResource InverseBoolToVisibility}}">
                                            <Grid Width="10" Height="10">
                                                <Path Data="M 1 1 L 9 5 L 1 9 Z"
                                                      Fill="{DynamicResource ForegroundDarkerBrush}">
                                                    <Path.Style>
                                                        <Style TargetType="{x:Type Path}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTracking}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <StackPanel.Style>
                                                        <Style TargetType="{x:Type StackPanel}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTracking}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Border Width="3" Height="8" CornerRadius="1"
                                                            Background="{DynamicResource AccentBrush}" />
                                                    <Border Width="3" Height="8" CornerRadius="1" Margin="3,0,0,0"
                                                            Background="{DynamicResource AccentBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <Button Style="{StaticResource IconButton}" Padding="4"
                                                VerticalAlignment="Top"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{DynamicResource L.DeleteTask}"
                                                AutomationProperties.Name="{DynamicResource L.DeleteTask}">
                                            <Path Data="M 2 2 L 8 8 M 8 2 L 2 8"
                                                  Stroke="{DynamicResource ForegroundDarkerBrush}" StrokeThickness="1.3"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
            </ListBox>

            <Canvas x:Name="DropOverlay" Grid.Row="2" Margin="8,4,4,4"
                    IsHitTestVisible="False" ClipToBounds="True" Panel.ZIndex="5">
                <Border x:Name="DragGhost" Visibility="Collapsed" Opacity="0.9"
                        CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource BackgroundLightBrush}"
                        BorderBrush="{DynamicResource BackgroundLightestBrush}"
                        IsHitTestVisible="False">
                    <Rectangle x:Name="DragGhostVisual" />
                </Border>
                <Border x:Name="DropLine" Height="2" CornerRadius="1"
                        Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
            </Canvas>

            <TextBlock Text="{DynamicResource L.NoTasks}" Width="190"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource ForegroundDarkerBrush}">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource BackgroundLightestBrush}"
                BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <TextBlock Text="{Binding RemainingText}" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource ForegroundDarkerBrush}" />
                <Button Content="{DynamicResource L.ClearCompleted}"
                        Command="{Binding ClearCompletedCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Padding="10,5" FontSize="11" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
