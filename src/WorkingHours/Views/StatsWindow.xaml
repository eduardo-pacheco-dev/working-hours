<Window x:Class="WorkingHours.Views.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WorkingHours.Controls"
        xmlns:views="clr-namespace:WorkingHours.Views"
        Title="{DynamicResource L.Statistics}"
        Width="720" Height="720" MinWidth="600" MinHeight="580"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource AppFont}" FontSize="13" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BackgroundLightestBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="{DynamicResource L.Statistics}" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="24,0,0,0" />
                <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,12,0" Click="Close_Click"
                        ToolTip="{DynamicResource L.Close}">
                    <Path Data="M 2 2 L 12 12 M 12 2 L 2 12" Stroke="{DynamicResource ForegroundDarkerBrush}"
                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </Grid>

            <!-- Tabs -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,8">
                <RadioButton x:Name="FocusTab" Style="{StaticResource StatsTab}" GroupName="StatsTab"
                             Content="{DynamicResource L.Focus}" IsChecked="True"
                             Click="FocusTab_Click" />
                <RadioButton x:Name="TasksTab" Style="{StaticResource StatsTab}" GroupName="StatsTab"
                             Content="{DynamicResource L.Tasks}" Margin="6,0"
                             Click="TasksTab_Click" />
            </StackPanel>

            <Grid Grid.Row="2">
                <!-- Focus statistics -->
                <Grid x:Name="FocusContent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Range selector -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,4">
                        <RadioButton Style="{StaticResource PillRadio}" GroupName="Range" Content="{DynamicResource L.Today}"
                                     IsChecked="{Binding IsDaily, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource PillRadio}" GroupName="Range" Content="{DynamicResource L.ThisWeek}"
                                     IsChecked="{Binding IsWeekly, Mode=TwoWay}" Margin="6,0" />
                        <RadioButton Style="{StaticResource PillRadio}" GroupName="Range" Content="{DynamicResource L.AllTime}"
                                     IsChecked="{Binding IsAllTime, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Period navigation -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,10">
                        <Button Style="{StaticResource IconButton}" Command="{Binding PreviousCommand}" Padding="8"
                                ToolTip="{DynamicResource L.Previous}">
                            <Path Data="M 9 2 L 3 8 L 9 14" Stroke="{DynamicResource ForegroundDarkerBrush}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                        <TextBlock Text="{Binding PeriodLabel}" MinWidth="150" TextAlignment="Center"
                                   VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Margin="8,0" />
                        <Button Style="{StaticResource IconButton}" Command="{Binding NextCommand}" Padding="8"
                                ToolTip="{DynamicResource L.Next}">
                            <Path Data="M 3 2 L 9 8 L 3 14" Stroke="{DynamicResource ForegroundDarkerBrush}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                    </StackPanel>

                    <!-- Summary -->
                    <UniformGrid Grid.Row="2" Columns="4" Margin="18,0,18,14">
                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="5">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.TotalFocus}" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding FocusTimeText}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="5">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.Sessions}" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding SessionsText}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="5">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.CurrentStreak}" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding StreakText}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="5">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.BestDay}" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding BestDayText}" FontSize="15" FontWeight="SemiBold" Margin="0,9,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Chart -->
                    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="23,0,23,10" Padding="20,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{DynamicResource L.FocusByHour}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWeekly}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource L.FocusThisWeek}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsAllTime}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource L.FocusAllTime}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Grid Grid.Row="1">
                                <controls:BarChart x:Name="Chart" Values="{Binding ChartValues}" Labels="{Binding ChartLabels}"
                                                   Visibility="{Binding IsDaily, Converter={StaticResource BoolToVisibility}}" />
                                <controls:BarChart Values="{Binding ChartValues}" Labels="{Binding ChartLabels}"
                                                   Visibility="{Binding IsWeekly, Converter={StaticResource BoolToVisibility}}" />
                                <controls:Heatmap x:Name="Heatmap" Values="{Binding HeatmapValues}" Height="230"
                                                  VerticalAlignment="Center"
                                                  Visibility="{Binding IsAllTime, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Text="{DynamicResource L.NoDataYet}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="{DynamicResource ForegroundDarkerBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasChartData}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="4" Text="{DynamicResource L.StatisticsHint}" Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" Margin="0,0,0,18" />
                </Grid>

                <!-- Task statistics tab -->
                <views:TaskStatsView x:Name="TasksContent" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Border>
</Window>
