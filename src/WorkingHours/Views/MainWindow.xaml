<Window x:Class="WorkingHours.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WorkingHours.Controls"
        Title="{Binding WindowTitle}"
        Width="420" Height="640" MinWidth="320" MinHeight="430"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource AppFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Topmost="{Binding IsPinned, Mode=TwoWay}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BackgroundLightestBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="22" Height="22" CornerRadius="7" Background="{DynamicResource FocusBrush}">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource BackgroundBrush}" />
                    </Border>
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource L.AppName}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="BrandSubtitle" Text="{Binding RoundLabel}" FontSize="10"
                                   Foreground="{DynamicResource ForegroundDarkerBrush}"
                                   Visibility="{Binding IsCompact, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource WindowButton}" Command="{Binding TogglePinCommand}"
                            ToolTip="{DynamicResource L.PinOnTop}"
                            AutomationProperties.Name="{DynamicResource L.PinOnTop}">
                        <TextBlock x:Name="PinGlyph" Text="&#xE718;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource ForegroundDarkerBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Style="{StaticResource WindowButton}" Click="Stats_Click"
                            ToolTip="{DynamicResource L.Statistics}"
                            AutomationProperties.Name="{DynamicResource L.Statistics}">
                        <Path Data="M 1 13 L 15 13 M 3 11 L 3 6 M 8 11 L 8 2 M 13 11 L 13 8"
                              Stroke="{DynamicResource ForegroundDarkerBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                    <Button Style="{StaticResource WindowButton}" Click="Settings_Click"
                            ToolTip="{DynamicResource L.Settings}"
                            AutomationProperties.Name="{DynamicResource L.Settings}">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="13" Foreground="{DynamicResource ForegroundDarkerBrush}" />
                    </Button>
                    <Button Style="{StaticResource WindowButton}" Click="Minimize_Click"
                            ToolTip="{DynamicResource L.Minimize}"
                            AutomationProperties.Name="{DynamicResource L.Minimize}">
                        <Path Data="M 2 7 L 14 7" Stroke="{DynamicResource ForegroundDarkerBrush}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="Close_Click"
                            ToolTip="{DynamicResource L.Close}"
                            AutomationProperties.Name="{DynamicResource L.Close}">
                        <Path Data="M 2 2 L 12 12 M 12 2 L 2 12" Stroke="{DynamicResource ForegroundDarkerBrush}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Timer -->
            <Grid Grid.Row="1" Margin="20,0,20,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,4,0,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding RoundLabel}" FontSize="15" FontWeight="SemiBold" Margin="7,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="RoundDetail" Text="{Binding RoundDetail}" HorizontalAlignment="Center"
                               Margin="0,3,0,0" FontSize="11"
                               Foreground="{DynamicResource ForegroundDarkerBrush}"
                               Visibility="{Binding IsCompact, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>

                <Viewbox Grid.Row="1" Stretch="Uniform" Margin="6" HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch" MaxWidth="380" MaxHeight="380">
                    <controls:ProgressDial x:Name="Dial" Width="340" Height="340"
                                           Progress="{Binding Progress}"
                                           Round="{Binding Round}"
                                           TimeText="{Binding TimeText}"
                                           StatusText="{Binding StatusText}"
                                           DialCountdown="{Binding DialCountdown}"
                                           IsPaused="{Binding IsPaused}"
                                           IsRunning="{Binding IsRunning}" />
                </Viewbox>

                <ItemsControl Grid.Row="2" ItemsSource="{Binding RoundDots}" HorizontalAlignment="Center"
                              Margin="0,2,0,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Height="7" CornerRadius="4" Margin="4,0">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Width" Value="7" />
                                        <Setter Property="Opacity" Value="0.45" />
                                        <Setter Property="Background" Value="{DynamicResource BackgroundLightestBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ForegroundDarkestBrush}" />
                                                <Setter Property="Opacity" Value="0.85" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Width" Value="22" />
                                                <Setter Property="Opacity" Value="1" />
                                                <Setter Property="Background" Value="{DynamicResource FocusBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Button Style="{StaticResource TransportButton}" Command="{Binding ResetCommand}"
                            ToolTip="{DynamicResource L.Reset}"
                            AutomationProperties.Name="{DynamicResource L.Reset}">
                        <Path Data="M 12.5 5.5 A 5.5 5.5 0 1 0 13 9 M 12.5 1.5 L 12.5 5.5 L 8.5 5.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>

                    <Button Style="{StaticResource PlayButton}" Command="{Binding ToggleCommand}"
                            ToolTip="{Binding PlayPauseTooltip}" Margin="22,0"
                            AutomationProperties.Name="{Binding PlayPauseTooltip}">
                        <Grid Width="22" Height="24">
                            <Path Data="M 1 0 L 22 12 L 1 24 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Width="6" Height="20" CornerRadius="2"
                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <Border Width="6" Height="20" CornerRadius="2" Margin="6,0,0,0"
                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource TransportButton}" Command="{Binding SkipCommand}"
                            ToolTip="{DynamicResource L.Skip}"
                            AutomationProperties.Name="{DynamicResource L.Skip}">
                        <Grid Width="17" Height="16">
                            <Path Data="M 1 1 L 13 8 L 1 15 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <Rectangle Width="2.5" Height="14" RadiusX="1.2" RadiusY="1.2"
                                       HorizontalAlignment="Right"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="18,0,18,0"
                  Visibility="{Binding IsCompact, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource IconButton}" Command="{Binding ToggleMuteCommand}"
                        ToolTip="{Binding MuteTooltip}" VerticalAlignment="Center" Padding="7"
                        AutomationProperties.Name="{Binding MuteTooltip}">
                    <Grid Width="16" Height="16">
                        <Path Data="M 1 6 L 4 6 L 7 3 L 7 13 L 4 10 L 1 10 Z"
                              Fill="{DynamicResource ForegroundDarkerBrush}" />
                        <Path Data="M 10 5 C 11.5 6.5 11.5 9.5 10 11" Stroke="{DynamicResource ForegroundDarkerBrush}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Path x:Name="MuteSlash" Data="M 9 5 L 14 13" Stroke="{DynamicResource DangerBrush}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="5" Padding="6,2" Margin="0,0,5,0">
                        <TextBlock Text="Space" FontSize="10" Foreground="{DynamicResource ForegroundDarkerBrush}" />
                    </Border>
                    <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="5" Padding="6,2" Margin="0,0,5,0">
                        <TextBlock Text="R" FontSize="10" Foreground="{DynamicResource ForegroundDarkerBrush}" />
                    </Border>
                    <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="5" Padding="6,2">
                        <TextBlock Text="→" FontSize="10" Foreground="{DynamicResource ForegroundDarkerBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
