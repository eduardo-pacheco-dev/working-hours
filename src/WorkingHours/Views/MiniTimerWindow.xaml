<Window x:Class="WorkingHours.Views.MiniTimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WorkingHours.Controls"
        Title="{DynamicResource L.MiniMode}"
        Width="184" Height="252" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" ShowActivated="False" WindowStartupLocation="Manual"
        FontFamily="{DynamicResource AppFont}" FontSize="13" UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="MiniPlayButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootCard" Margin="10" CornerRadius="20"
            Background="{DynamicResource BackgroundLightBrush}"
            BorderBrush="{DynamicResource BackgroundLightestBrush}" BorderThickness="1"
            MouseLeftButtonDown="RootCard_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.4" Color="Black" />
        </Border.Effect>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="{Binding RoundLabel}" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RoundDetail}" FontSize="9"
                                   Foreground="{DynamicResource ForegroundDarkerBrush}" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource IconButton}" Padding="5"
                        Click="Expand_Click" ToolTip="{DynamicResource L.Expand}"
                        AutomationProperties.Name="{DynamicResource L.Expand}">
                    <Path Data="M 1 5 L 1 1 L 5 1 M 7 1 L 11 1 L 11 5 M 11 7 L 11 11 L 7 11 M 5 11 L 1 11 L 1 7"
                          Stroke="{DynamicResource ForegroundDarkerBrush}" StrokeThickness="1.3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Padding="5"
                        Click="Close_Click" ToolTip="{DynamicResource L.Close}"
                        AutomationProperties.Name="{DynamicResource L.Close}">
                    <Path Data="M 2 2 L 10 10 M 10 2 L 2 10"
                          Stroke="{DynamicResource ForegroundDarkerBrush}" StrokeThickness="1.3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </Grid>

            <!-- Active task -->
            <Border Grid.Row="1" Margin="2,4,2,0" Padding="7,4" CornerRadius="7"
                    Background="{DynamicResource BackgroundBrush}"
                    Visibility="{Binding Todos.HasActiveTask, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Todos.ActiveTaskText}" Margin="5,0,0,0"
                               FontSize="10.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Todos.ActiveTaskText}"
                               Foreground="{DynamicResource ForegroundDarkerBrush}" />
                </StackPanel>
            </Border>

            <!-- Clock -->
            <Viewbox Grid.Row="2" Stretch="Uniform" Margin="2,4">
                <controls:ProgressDial x:Name="Dial" Width="136" Height="136"
                                       Progress="{Binding Progress}"
                                       Round="{Binding Round}"
                                       TimeText="{Binding TimeText}"
                                       DialCountdown="{Binding DialCountdown}"
                                       IsPaused="{Binding IsPaused}"
                                       IsRunning="{Binding IsRunning}"
                                       ShowStatus="False" ShowTicks="False" />
            </Viewbox>

            <!-- Controls -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,2,0,0">
                <Button Style="{StaticResource TransportButton}" Command="{Binding ResetCommand}"
                        Padding="8" ToolTip="{DynamicResource L.Reset}"
                        AutomationProperties.Name="{DynamicResource L.Reset}">
                    <Path Data="M 12.5 5.5 A 5.5 5.5 0 1 0 13 9 M 12.5 1.5 L 12.5 5.5 L 8.5 5.5"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>

                <Button Style="{StaticResource MiniPlayButton}" Command="{Binding ToggleCommand}"
                        Margin="14,0" ToolTip="{Binding PlayPauseTooltip}"
                        AutomationProperties.Name="{Binding PlayPauseTooltip}">
                    <Grid Width="14" Height="16">
                        <Path Data="M 1 0 L 14 8 L 1 16 Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Margin="2,0,0,0">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="4" Height="14" CornerRadius="1.5"
                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <Border Width="4" Height="14" CornerRadius="1.5" Margin="4,0,0,0"
                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Style="{StaticResource TransportButton}" Command="{Binding SkipCommand}"
                        Padding="8" ToolTip="{DynamicResource L.Skip}"
                        AutomationProperties.Name="{DynamicResource L.Skip}">
                    <Grid Width="14" Height="14">
                        <Path Data="M 1 1 L 11 7 L 1 13 Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <Rectangle Width="2" Height="12" RadiusX="1" RadiusY="1" HorizontalAlignment="Right"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
