<Window x:Class="WorkingHours.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Title="{DynamicResource L.AppName}">
    <Border Background="{DynamicResource BackgroundLightBrush}"
            BorderBrush="{DynamicResource BackgroundLightestBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.35" Color="Black" />
        </Border.Effect>
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="4" CornerRadius="2" Background="{DynamicResource AccentBrush}"
                    Margin="0,2,14,2" Grid.Column="0" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="BodyText" FontSize="12" Margin="0,4,0,0"
                           Foreground="{DynamicResource ForegroundDarkerBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Padding="6"
                    VerticalAlignment="Top" Click="Close_Click"
                    ToolTip="{DynamicResource L.Close}">
                <Path Data="M 0 0 L 9 9 M 9 0 L 0 9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" />
            </Button>
        </Grid>
    </Border>
</Window>
