<Window x:Class="WorkingHours.Views.TaskStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.TaskStatistics}"
        Width="660" Height="700" MinWidth="560" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource AppFont}" FontSize="13" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BackgroundLightestBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="{DynamicResource L.TaskStatistics}" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="24,0,0,0" />
                <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,12,0" Click="Close_Click"
                        ToolTip="{DynamicResource L.Close}"
                        AutomationProperties.Name="{DynamicResource L.Close}">
                    <Path Data="M 2 2 L 12 12 M 12 2 L 2 12" Stroke="{DynamicResource ForegroundDarkerBrush}"
                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </Grid>

            <!-- Filters -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,8">
                <RadioButton Style="{StaticResource PillRadio}" GroupName="TaskFilter"
                             Content="{DynamicResource L.AllTasks}"
                             IsChecked="{Binding IsAll, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource PillRadio}" GroupName="TaskFilter"
                             Content="{DynamicResource L.PendingTasks}"
                             IsChecked="{Binding IsPending, Mode=TwoWay}" Margin="6,0" />
                <RadioButton Style="{StaticResource PillRadio}" GroupName="TaskFilter"
                             Content="{DynamicResource L.CompletedTasks}"
                             IsChecked="{Binding IsCompleted, Mode=TwoWay}" />
            </StackPanel>

            <!-- Summary -->
            <UniformGrid Grid.Row="2" Columns="4" Margin="18,0,18,14">
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="5">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.TotalTracked}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding TrackedTimeText}" FontSize="21" FontWeight="SemiBold"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="5">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.CompletedTasks}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding CompletedText}" FontSize="24" FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="5">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.PendingTasks}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding PendingText}" FontSize="24" FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="5">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.AvgCompleted}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding AverageCompletedText}" FontSize="21" FontWeight="SemiBold"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Per-task breakdown -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="23,0,23,10" Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource L.TimePerTask}" FontSize="13"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{DynamicResource L.MostTime}" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding MostTimeText}" FontSize="11.5"
                                       Foreground="{DynamicResource ForegroundDarkerBrush}"
                                       MaxWidth="300" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding MostTimeText}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6" CornerRadius="8" Margin="0,2">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource BackgroundBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Grid Width="18" Height="18" Margin="0,2,10,0"
                                                      VerticalAlignment="Top">
                                                    <Ellipse StrokeThickness="1.2" Margin="0.5">
                                                        <Ellipse.Style>
                                                            <Style TargetType="{x:Type Ellipse}">
                                                                <Setter Property="Stroke"
                                                                        Value="{DynamicResource ForegroundDarkerBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                        <Setter Property="Fill"
                                                                                Value="{DynamicResource AccentBrush}" />
                                                                        <Setter Property="Stroke"
                                                                                Value="{DynamicResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <Path Data="M 4 9 L 7.5 12.5 L 14 5"
                                                          Stroke="{DynamicResource OnAccentBrush}"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                        <Path.Style>
                                                            <Style TargetType="{x:Type Path}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Grid>

                                                <StackPanel Grid.Column="1" Margin="0,1,12,0">
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                               FontSize="12.5" />
                                                    <ProgressBar Style="{StaticResource TaskBar}"
                                                                 Value="{Binding BarPercent}"
                                                                 Margin="0,6,0,0" />
                                                    <TextBlock Text="{Binding CompletionText}" FontSize="10"
                                                               Margin="0,3,0,0"
                                                               Foreground="{DynamicResource ForegroundDarkerBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CompletionText}"
                                                                                 Value="">
                                                                        <Setter Property="Visibility"
                                                                                Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{Binding TimeText}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           VerticalAlignment="Top" Margin="0,2,0,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Text="{DynamicResource L.NoTaskStats}" Width="260"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource ForegroundDarkerBrush}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRows}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <TextBlock Grid.Row="4" Text="{DynamicResource L.TaskStatsHint}"
                       Style="{StaticResource MutedText}"
                       HorizontalAlignment="Center" Margin="0,0,0,18" />
        </Grid>
    </Border>
</Window>
