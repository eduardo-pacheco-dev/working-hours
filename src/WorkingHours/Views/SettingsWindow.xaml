<Window x:Class="WorkingHours.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.Settings}"
        Width="580" Height="720" MinWidth="540" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource AppFont}" FontSize="13" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BackgroundLightestBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="76" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="{DynamicResource L.Settings}" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="24,0,0,0" />
                <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,12,0" Click="Cancel_Click"
                        ToolTip="{DynamicResource L.Close}">
                    <Path Data="M 2 2 L 12 12 M 12 2 L 2 12" Stroke="{DynamicResource ForegroundDarkerBrush}"
                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </Grid>

            <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,18,18">
                <StackPanel>
                    <!-- Timer -->
                    <TextBlock Text="{DynamicResource L.Timer}" Style="{StaticResource CaptionText}" Margin="2,8,0,8" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource L.FocusDuration}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundDarkerBrush}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Width="66" TextAlignment="Center" MaxLength="3"
                                             Text="{Binding WorkMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{DynamicResource L.Minutes}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource ForegroundDarkerBrush}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource L.ShortBreakDuration}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundDarkerBrush}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Width="66" TextAlignment="Center" MaxLength="3"
                                             Text="{Binding ShortBreakMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{DynamicResource L.Minutes}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource ForegroundDarkerBrush}" />
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource L.LongBreakDuration}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundDarkerBrush}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Width="66" TextAlignment="Center" MaxLength="3"
                                             Text="{Binding LongBreakMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{DynamicResource L.Minutes}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource ForegroundDarkerBrush}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Cycle -->
                    <TextBlock Text="{DynamicResource L.Cycle}" Style="{StaticResource CaptionText}" Margin="2,20,0,8" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource L.RoundsBeforeLongBreak}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundDarkerBrush}" />
                                <TextBox Grid.Column="1" Width="66" TextAlignment="Center" MaxLength="2"
                                         Text="{Binding LongBreakInterval, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <CheckBox Content="{DynamicResource L.EnableShortBreaks}" IsChecked="{Binding ShortBreaksEnabled}" Margin="0,0,0,12" />
                            <CheckBox Content="{DynamicResource L.EnableLongBreaks}" IsChecked="{Binding LongBreaksEnabled}" Margin="0,0,0,12" />
                            <CheckBox Content="{DynamicResource L.AutoStartWork}" IsChecked="{Binding AutoStartWork}" Margin="0,0,0,12" />
                            <CheckBox Content="{DynamicResource L.AutoStartBreaks}" IsChecked="{Binding AutoStartBreak}" />
                        </StackPanel>
                    </Border>

                    <!-- Appearance -->
                    <TextBlock Text="{DynamicResource L.Appearance}" Style="{StaticResource CaptionText}" Margin="2,20,0,8" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource L.ThemeMode}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundDarkerBrush}" />
                                <ComboBox x:Name="ModeCombo" Grid.Column="1"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding ThemeMode}" />
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource L.LightTheme}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundDarkerBrush}" />
                                <ComboBox x:Name="LightThemeCombo" Grid.Column="1"
                                          SelectedValue="{Binding ThemeLight}" />
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource L.DarkTheme}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundDarkerBrush}" />
                                <ComboBox x:Name="DarkThemeCombo" Grid.Column="1"
                                          SelectedValue="{Binding ThemeDark}" />
                            </Grid>
                            <CheckBox Content="{DynamicResource L.DialCountdown}" IsChecked="{Binding DialCountdown}" Margin="0,0,0,6" />
                            <TextBlock Text="{DynamicResource L.DialHint}" Style="{StaticResource MutedText}" Margin="48,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- System -->
                    <TextBlock Text="{DynamicResource L.System}" Style="{StaticResource CaptionText}" Margin="2,20,0,8" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Content="{DynamicResource L.TrayIcon}" IsChecked="{Binding TrayIconEnabled}" Margin="0,0,0,12" />
                            <CheckBox Content="{DynamicResource L.MinimizeToTray}" IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,12" />
                            <CheckBox Content="{DynamicResource L.CloseToTray}" IsChecked="{Binding MinimizeToTrayOnClose}" Margin="0,0,0,12" />
                            <CheckBox Content="{DynamicResource L.AlwaysOnTop}" IsChecked="{Binding AlwaysOnTop}" Margin="0,0,0,12" />
                            <CheckBox Content="{DynamicResource L.Notifications}" IsChecked="{Binding NotificationsEnabled}" Margin="0,0,0,12" />
                            <CheckBox Content="{DynamicResource L.GlobalShortcuts}" IsChecked="{Binding GlobalShortcutsEnabled}" />
                            <TextBlock Text="{DynamicResource L.GlobalShortcutsHint}" Style="{StaticResource MutedText}"
                                       Margin="48,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Sound -->
                    <TextBlock Text="{DynamicResource L.Sound}" Style="{StaticResource CaptionText}" Margin="2,20,0,8" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="42" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource L.VolumeLabel}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundDarkerBrush}" Margin="0,0,16,0" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                        Value="{Binding VolumePercent, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="2" Text="{Binding VolumePercent, StringFormat={}{0}%}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource ForegroundDarkerBrush}" />
                            </Grid>
                            <CheckBox Content="{DynamicResource L.TickWork}" IsChecked="{Binding TickSoundsDuringWork}" Margin="0,0,0,12" />
                            <CheckBox Content="{DynamicResource L.TickBreak}" IsChecked="{Binding TickSoundsDuringBreak}" />
                        </StackPanel>
                    </Border>

                    <!-- Language / about -->
                    <TextBlock Text="{DynamicResource L.About}" Style="{StaticResource CaptionText}" Margin="2,20,0,8" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource L.Language}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundDarkerBrush}" />
                                <ComboBox x:Name="LanguageCombo" Grid.Column="1"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Language}" />
                            </Grid>
                            <TextBlock Text="{DynamicResource L.AboutText}" Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="{DynamicResource L.AutoSaveHint}" Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap" Margin="0,0,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="{DynamicResource L.OpenDataFolder}" Style="{StaticResource SecondaryButton}"
                                        Padding="12,6" Click="OpenDataFolder_Click" />
                                <TextBlock Grid.Column="1" x:Name="DataFolderText" Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="{DynamicResource L.ResetStatistics}"
                                        Style="{StaticResource SecondaryButton}" Padding="12,6"
                                        Click="ResetStatistics_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{DynamicResource BackgroundLightestBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,24,0">
                    <Button Content="{DynamicResource L.Cancel}" Style="{StaticResource SecondaryButton}"
                            Click="Cancel_Click" Margin="0,0,10,0" />
                    <Button Content="{DynamicResource L.Save}" Style="{StaticResource PrimaryButton}"
                            Click="Save_Click" MinWidth="130" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
